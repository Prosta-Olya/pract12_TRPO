<Page x:Class="pract12_TRPO.Pages.AddInterestGroup"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract12_TRPO.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddInterestGroup">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Click="Button_Click_1" Grid.Column="0">Назад</Button>
        </Grid>

        <StackPanel Grid.Row="1">
            <StackPanel>
                <Label>Название группы</Label>
                <TextBox Text="{Binding Title}"/>
            </StackPanel>
            <StackPanel>
                <Label>Описание</Label>
                <TextBox Text="{Binding Description}"/>
            </StackPanel>
            <StackPanel>
                <Button Click="Button_Click">Сохранить</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
